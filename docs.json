{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "EmPay HRMS API",
  "colors": {
    "primary": "#E8390E",
    "light": "#E8390E",
    "dark": "#E8390E"
  },
  "redirects": [
    {
      "source": "/product-overview",
      "destination": "/introduction"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@empay.example"
      }
    ],
    "primary": {
      "type": "button",
      "label": "View API Reference",
      "href": "/api-reference/overview"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "pages": [
          {
            "group": "Learn About EmPay",
            "pages": ["introduction"]
          },
          {
            "group": "EmPay Architecture",
            "pages": ["concepts/system-overview"]
          },
          {
            "group": "Platform concepts",
            "pages": ["concepts/roles-and-permissions"]
          }
        ]
      },
      {
        "tab": "Getting Started",
        "pages": [
          {
            "group": "Quickstart",
            "pages": ["getting-started"]
          },
          {
            "group": "Core workflows",
            "pages": [
              "guides/request-and-review-leave",
              "guides/generate-payroll"
            ]
          },
          {
            "group": "Test and troubleshoot",
            "pages": ["troubleshooting"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          {
            "group": "About API",
            "pages": [
              "api-reference/overview",
              "api-reference/openapi-specification",
              "api-reference/rate-limits-and-authentication",
              "api-reference/error-codes"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.yaml"
          }
        ]
      },
      {
        "tab": "Change Logs",
        "pages": ["changelog"]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required",
      "prefill": true
    }
  }
}
